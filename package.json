{
  "name": "terrax",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @terrax/api dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "^1.4.0",
    "typescript": "latest"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}