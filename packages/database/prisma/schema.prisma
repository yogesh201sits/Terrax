// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys ApiKey[]
  traces  Trace[]

  @@index([userId])
  @@map("projects")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String?
  keyHash    String    @unique
  keyPrefix  String?
  projectId  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_keys")
}

model Notification {
  id        String   @id @default(uuid())

  userId    String
  projectId String?

  type      String
  title     String
  message   String

  metadata  Json?

  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationDelivery {
  id String @id @default(uuid())

  notificationId String
  channel        String
  status         String   @default("pending")

  deliveredAt DateTime?
  readAt      DateTime?
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([channel, status])
  @@map("notification_deliveries")
}

model Trace {
  id        String   @id @default(uuid())
  projectId String
  traceId   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spans   Span[]

  @@unique([projectId, traceId])
  @@index([projectId])
  @@map("traces")
}

model Span {
  id           String  @id @default(uuid())
  traceId      String
  spanId       String
  parentSpanId String?

  name      String
  startTime DateTime
  endTime   DateTime

  status     Json?
  attributes Json?
  events     Json?
  resource   Json?

  traceIdRef String
  trace      Trace  @relation(fields: [traceIdRef], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([traceId, spanId])
  @@index([traceId])
  @@index([parentSpanId])
  @@index([traceIdRef])
  @@map("spans")
}
